.projects
  .container 
    h2.title
      |Projects
    .swiper__container.swiper
      .swiper-wrapper.projects__cards-container
        each project in projectCardContent
          +project-card(
            project.imgSrc, 
            project.imgAlt, 
            project.cardTitle, 
            project.cardDescription, 
            project.techStack, 
            project.githubLink,
            'swiper-slide'
          )
    .swiper-button-prev
    .swiper-button-next