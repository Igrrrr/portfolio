mixin list(listClass, array, linkClass, itemClass, imgClass)
  ul(class=listClass)
    each element in array
      li(class=linkClass)
        -
          var hrefValue = '';
          if (typeof element === 'string') {
            hrefValue = '#' + element;
          } else if (typeof element === 'object' && element !== null && element.href) {
            hrefValue = element.href;
          }
        a(class=itemClass, href=hrefValue, target='_blank')
          if (typeof element === 'object' && element !== null && element.imgSrc)
            img(class=imgClass, src=element.imgSrc, alt=element.imgAlt)
          else
            | #{element}


mixin skill-card(imgSrc, altText)
  .skill-card 
    span 
    .skill-card__content-wrapper
      img.skill-card__icon(src=imgSrc, alt=altText)

mixin project-card(imgSrc, imgAlt, cardTitle, cardDescription, techStack, githubLink, extraClass)
  .card(class=extraClass)
    .card__img-container
      img.card__img(src=imgSrc, alt=imgAlt)
    .card__specification 
      h2.card__title= cardTitle
      h3.card__description !{cardDescription}
      h3.card__skills 
        b 
          |Tech stack: 
        | #{techStack}
      .card__link 
        a.card__icon-link(href=githubLink target="blanc")
          img.card__icon-picture(src="@img/ghblack.svg", alt="github")
        a.card__text-link(href=githubLink target="blanc")
            |Repository